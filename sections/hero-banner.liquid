{{ 'hero-banner.css' | asset_url | stylesheet_tag }}





{% liquid
  assign hero_heading = section.settings.hero_heading
  assign hero_heading_size = section.settings.hero_heading_size
  assign hero_heading_color = section.settings.hero_heading_color
  assign hero_heading_width = section.settings.hero_heading_width

  assign hero_sub_heading = section.settings.hero_Sub_Heading
  assign hero_sub_heading_size = section.settings.hero_sub_heading_size
  assign hero_sub_heading_color = section.settings.hero_sub_heading_color
  assign hero_sub_heading_width = section.settings.hero_sub_heading_width
  assign hero_sub_heading_line_height = section.settings.hero_sub_heading_line_height

  assign feature_button_bg_1 = section.settings.feature_button_bg_1
  assign feature_button_radius_1 = section.settings.feature_button_radius_1
  assign feature_button_padding_2 = section.settings.feature_button_padding_2
  assign feature_button_padding_1 = section.settings.feature_button_padding_1
  assign feature_button_text_1 = section.settings.feature_button_text_1
  assign feature_button_text_color_1 = section.settings.feature_button_text_color_1
  assign feature_button_icon_1 = section.settings.feature_button_icon_1
  assign hero_features_button_gap = section.settings.hero_features_button_gap

  assign feature_button_bg_2 = section.settings.feature_button_bg_2
  assign feature_button_radius_2 = section.settings.feature_button_radius_2
  assign feature_button_text_2 = section.settings.feature_button_text_2
  assign feature_button_text_color_2 = section.settings.feature_button_text_color_2
  assign feature_button_icon_2 = section.settings.feature_button_icon_2

  assign search_bar_bg = section.settings.search_bar_bg
  assign search_bar_radius = section.settings.search_bar_radius
  assign search_bar_icon = section.settings.search_bar_icon
  assign search_bar_padding = section.settings.search_bar_padding
  assign search_bar_text = section.settings.search_bar_text

  assign search_bar_button_bg = section.settings.search_bar_button_bg
  assign search_bar_button_radius = section.settings.search_bar_button_radius
  assign search_bar_button_padding = section.settings.search_bar_button_padding
  assign search_bar_button_text = section.settings.search_bar_button_text
  assign search_bar_button_text_color = section.settings.search_bar_button_text_color
  assign search_bar_button_icon = section.settings.search_bar_button_icon
  assign section_width = section.settings.section_width
  assign slide_radius = section.settings.slide_radius
  assign slider_width = section.settings.slider_width
  assign slider_height = section.settings.slider_height
%}

  



<section class="hero-banner color-{{ section.settings.color_scheme }} gradient" style=" --hero_heading_size: {{ hero_heading_size }}px; --hero_heading_color: {{ hero_heading_color }}; --hero_heading_width: {{ hero_heading_width }}px; --hero_sub_heading_size: {{ hero_sub_heading_size }}px; --hero_sub_heading_line_height: {{ hero_sub_heading_line_height }}%; --hero_sub_heading_color: {{ hero_sub_heading_color }}; --hero_sub_heading_width: {{ hero_sub_heading_width }}px; --feature_button_bg_1: {{ feature_button_bg_1 }}; --feature_button_radius_1: {{ feature_button_radius_1 }}px; --feature_button_text_color_1: {{ feature_button_text_color_1 }}; --feature_button_bg_2: {{ feature_button_bg_2 }}; --feature_button_radius_2: {{ feature_button_radius_2 }}px; --feature_button_text_color_2: {{ feature_button_text_color_2 }}; --feature_button_padding_1: {{ feature_button_padding_1 }}px; --feature_button_padding_2: {{ feature_button_padding_2 }}px; --hero_features_button_gap:  {{ hero_features_button_gap }}px; --section_width: {{ section_width }}; --search_bar_padding: {{ search_bar_padding }}px; --search_bar_bg: {{ search_bar_bg }}; --search_bar_radius: {{ search_bar_radius }}px; --search_bar_button_bg: {{ search_bar_button_bg }}; --search_bar_button_radius: {{ search_bar_button_radius }}px; --search_bar_button_padding: {{ search_bar_button_padding }}px; --search_bar_button_text_color: {{ search_bar_button_text_color }}; --slide_radius: {{ slide_radius }}px; --slider_height: {{ slider_height }}px; ">

<div class="hero-banner-slide" >

    <div class="swiper hero-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
    {% for block in section.blocks %}
        {% liquid
            assign slide = block.settings.slide
        %}
      <div class="swiper-slide slide">

        {% if slide %}
            {{ slide
            |  image_url: width: 1600
            |  image_tag:
            loading: 'lazy',
            fetchpriority: 'high',
            class: 'slide_image'        
            }}
            {%  else %}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'slide_image' }}
        {% endif %}
         </div>
    {% endfor %}
       </div>
  </div>
</div>


<div class="hero-banner-content">
    <div class="page-width">

    <div class="hero-header-feature-search-container">

    <div class="hero-header">
        {% if hero_heading != blank %}
            <h2 class="heading">
                {{ hero_heading }}
            </h2>
        {% endif %}
       
        {% if hero_sub_heading %}
            <p class="sub-heading">
                {{ hero_sub_heading }}
            </p>
        {% endif %}
    </div>
  
    <div class="feature-buttons-and-search-bar">
        <div class="hero-feature-buttons">

            {% if feature_button_text_1 != blank %}
            <div class="feature-button-1">
                {% if feature_button_icon_1 %}
                    {{ feature_button_icon_1 
                    |  image_url: width: 20
                    |  image_tag:
                    fetchpriority: 'high',
                    loading: 'lazy',
                    class: 'feature_icon_1'
                    
                    }}
                {% endif %}

                {% if feature_button_text_1 %}
                   <p class="feature-button-text-1">
                     {{ feature_button_text_1 }}
                   </p>
                {% endif %}
            </div>
            {% endif %}

            {% if feature_button_text_2 != blank %}
            <div class="feature-button-2">
                {% if feature_button_icon_2 %}
                    {{ feature_button_icon_2 
                    |  image_url: width: 20
                    |  image_tag:
                    fetchpriority: 'high',
                    loading: 'lazy',
                    class: 'feature_icon_2'
                    
                    }}
                {% endif %}

                {% if feature_button_text_2 %}
                   <p class="feature-button-text-2">
                     {{ feature_button_text_2 }}
                   </p>
                {% endif %}
            </div>
              {% endif %}
        </div>

        <div class="search-bar-container">
                <div class="icon_and_heading">
                    {% if search_bar_icon %}
                        {{ search_bar_icon 
                        |  image_url: width: 50
                        |  image_tag:
                        fetchpriority: 'high',
                        loading: 'lazy',
                        class: 'search_bar_icon' 
                        
                        }}
                    {% endif %}

                    {% if search_bar_text %}
                        <h3 class="search-bar-heading">
                            {{ search_bar_text }}
                        </h3>
                    {% endif %}

                </div>

                <div class="search-bar-button">
                      {% if search_bar_button_text %}
                        <p class="search_bar_button_text">
                            {{ search_bar_button_text }}
                        </p>
                    {% endif %}

                    {% if search_bar_button_icon %}
                        {{ search_bar_button_icon
                        |  image_url: width: 20
                        |  image_tag:
                        fetchpriority: 'high',
                        loading: 'lazy',
                        class: 'search_bar_button_icon' 
                        }}
                    {% endif %}
                </div>
        </div>
    </div>

    </div>

    </div>
</div>

</section>

  <script>
    (function () {
      function initHeroSwiper() {
        var slider = document.querySelector('.hero-swiper-{{ section.id }}');

        if (!slider || typeof Swiper === 'undefined') return;
        if (slider.swiper) slider.swiper.destroy(true, true);

        new Swiper(slider, {
        speed: 2000,
        autoplay: {
        delay: 2500,
        disableOnInteraction: false,
      },
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroSwiper);
      } else {
        initHeroSwiper();
      }

      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail.sectionId === '{{ section.id }}') initHeroSwiper();
      });
    })();
  </script>


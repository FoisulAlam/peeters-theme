{% liquid
    assign title = section.settings.title
    assign title-size = section.settings.title-size
    assign title-color = section.settings.title-color
%}


<div class="container">
   <h2>
    {{ title }}
   </h2>

   {% if section.blocks.size > 0 %}
   <ul> 
   {% for block in section.blocks %}

    {% liquid

        assign border_radius = block.settings.border_radius
        assign aspect_ratio = block.settings.aspect_ratio 
        assign object_fit = block.settings.object_fit   

        assign icon = block.settings.icon
        assign media = block.settings.media
        assign block_title = block.settings.block_title
        assign alt_text = media.alt | default: block_title | escape
    %}

        {% case block.type %}

        {% when 'icon' %}
             <li class="block-icon">
            {% render 'icon', icon: icon %}
             <p> {{ block_title }} </p>
            </li>

        {% when 'media' %}
            <li class="media_icon">
             {% render 'media', media: media, border_radius: border_radius, aspect_ratio: aspect_ratio, object_fit: object_fit  %}
            </li>
         {% endcase %}
    
   {% endfor %}
    </ul>
    {% endif %}
</div>


{% schema %}
{
    "name": "Custom-Section",
    "tag": "section",
    "class": "custom-section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "blocks": [
        {
            "type": "icon",
            "name": "Icon",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "icon",
                    "label": "Icon"
                },
                {
                    "type": "text",
                    "id": "block_title",
                    "label": "Block Title",
                    "default": "This is the Block Title"
                }
            ]
        },

        {
            "type": "media",
            "name": "Media",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "media",
                    "label": "Media"
                },
                {
                    "type": "header",
                    "content": "Media Style"
                },
                {
                    "type": "select",
                    "id": "aspect_ratio",
                    "label": "Aspect Ratio",
                    "default": "auto",
                    "options": [
                        {
                            "label": "Adapt the default size", "value": "auto"
                        },
                        {
                            "label": "Potrait", "value": "2/3"
                        },
                        {
                            "label": "Horizontal", "value": "3/2"
                        },
                        {
                            "label": "Square", "value": "1/1"
                        }
                    ]
                },
                {
                    "type": "select",
                    "id": "object_fit",
                    "default": "none",
                    "label": "Object Fit",
                    "options": [
                        {
                            "label": "Cover", "value": "cover"
                        },
                        {
                            "label": "Contain", "value": "contain"
                        },
                        {
                            "label": "Scale Down", "value": "scale-down"
                        },
                        {
                            "label": "Fill", "value": "fill"
                        },
                        {
                            "label": "Auto", "value": "none"
                        }
                    ]
                }, 
                {
                    "type": "range",
                    "id": "border_radius",
                    "label": "Border Radius",
                    "max": 100,
                    "min": 0,
                    "step": 10,
                    "default": 10,
                    "unit": "px"
                }

            ]
        }
    ],
    "settings": [

    {
        "type": "select",
        "id": "layout_size",
        "label": "Section Width",
        "default": "1200px",
        "options": [
            {
                "label": "Full Width", "value": "100%"
            },
            {
                "label": "Container", "value": "1200px"
            }
        ]
    },
    {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "max": 200,
        "min": 20,
        "default": 20,
        "step": 20,
        "unit": "px"
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "max": 200,
        "min": 20,
        "default": 20,
        "step": 20,
        "unit": "px"
    },

    {
        "type": "select",
        "id": "select_bg",
        "label": "Select BG Type",
        "options": [
            {"label": "Image", "value": "image"},
            {"label": "Color", "value": "color"}
        ],
        "default": "color"
    },

    {
        "type": "color_background",
        "id": "section_bg",
        "label": "Section Background Color",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.select_bg == 'color' }}"
    },
    {
        "type": "image_picker",
        "id": "section_image_bg",
        "label": "Section Background Image",
        "visible_if": "{{ section.settings.select_bg == 'image' }}"
    },

    {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "This is the Title"
    },
    {
        "type": "select",
        "id": "title-size",
        "label": "Title Size",
        "default": "22px",
        "options": [
            {
                "label": "Large", "value": "55px"
            },
            {
                "label": "Medium", "value": "44px"
            },
            {
                "label": "Small", "value": "32px"
            },
            {
                "label": "Extra Small", "value": "22px"
            }
        ],
        "visible_if": "{{ section.settings.title != blank }}"
    },
    {
        "type": "color",
        "id": "title-color",
        "label": "Title Color",
        "default": "#000",
        "visible_if": "{{ section.settings.title != blank }}"
    }
    ],
    "presets": [
        {
            "name": "Custom Section"
        }
    ]
}
{% endschema %}









{% style %}
    * {
        margin: 0px;
        padding: 0px;
    }
    #shopify-section-{{ section.id }} .container {
        max-width: {{ section.settings.layout_size }} ;
        margin: 0px auto;
        padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    }
        #shopify-section-{{ section.id }} {
        {% if section.settings.select_bg == 'color' %}
            background: {{ section.settings.section_bg }};
        {% elsif section.settings.select_bg == 'image' and section.settings.section_image_bg != blank %}
            background-image: url('{{ section.settings.section_image_bg | image_url: width: 2000 }}');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        {% endif %}
    }
    #shopify-section-{{ section.id }} h2 {
        font-size: {{ title-size }};
        color: {{ title-color }};
    }

    #shopify-section-{{ section.id }} ul {
        display: flex;
        gap: 10px;
        list-style: none;
        flex-wrap: wrap;
    }
    #shopify-section-{{ section.id }} ul li.block-icon {
        display: flex;
        background: #000;
        border-radius: 12px;
        align-items: center;
        gap: 10px;
        color: white;
        padding: 6px 12px 6px 12px;
    }
    
    #shopify-section-{{ section.id }} .product-media__image {
        width: 350px;
        height: 200px;
    }
    #shopify-section-{{ section.id }} .product-icon__image {
        width: 40px;
        height: auto;
        border-radius: 6px;
    }
{% endstyle %}